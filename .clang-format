# Joist C style (plan §13: clang-format with a checked-in style file).
# Derived from the existing code in mcp-server/: 4-space indent, function braces
# on their own line, control-flow braces on the same line, braces on every
# if/else/loop body, `type *name`.
BasedOnStyle: LLVM
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 100
BreakBeforeBraces: Linux
PointerAlignment: Right
InsertBraces: true
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AlignConsecutiveMacros: Consecutive
AlignConsecutiveDeclarations: None
ReflowComments: false
SortIncludes: Never
IndentCaseLabels: false
SpaceAfterCStyleCast: false
