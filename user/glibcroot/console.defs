/* console.defs - the console glibcroot serves (Phase 5 step 7, the
   design's item 11 d; the owner's choices, 2026-11-07 and 2026-11-08):
   io.defs' first two routines, io_write and io_read, alone, as the GNU
   Hurd's io.defs declares them. A program's descriptors 0, 1 and 2 are
   send rights to it; every other io routine, and any other message, is
   answered MIG_BAD_ID.

   From hurd/io.defs, Copyright (C) 1991-2026 Free Software Foundation,
   Inc., under the GNU General Public License, version 2 or later; this
   file is GPL-3.0-only, as Joist. */

subsystem io 21000;

#include <hurd/hurd_types.defs>

INTR_INTERFACE

/* Write data to an IO object.  The amount successfully written is
   returned in AMOUNT. */
routine io_write (
	io_object: io_t;
	RPT
	data: data_t SCP;
	offset: loff_t;
	out amount: vm_size_t);

/* Read data from an IO object.  If offset is -1, read from the object
   maintained file pointer.  If the object is not seekable, offset is
   ignored.  The amount desired to be read is in AMOUNT. */
routine io_read (
	io_object: io_t;
	RPT
	out data: data_t, dealloc;
	offset: loff_t;
	amount: vm_size_t);
