@@ -285,7 +298,10 @@ extern int _hurd_select (int nfds, struct pollfd *pollfds,
 /* Apply AT_FLAGS on FLAGS, in preparation for calling
    __hurd_file_name_lookup.  */
 
-#if defined __USE_EXTERN_INLINES && defined _LIBC
