From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: aditya kale <252700881+kaleaditya28897-linux@users.noreply.github.com>
Date: Wed, 4 Nov 2026 18:30:35 +0530
Subject: [PATCH] hurd, mach, htl: build with clang, which has no extern
 inlines in libc

features.h gives clang's builds of libc no __USE_EXTERN_INLINES (public
headers' inlines would use functions before libc renames them, which
clang refuses). The Hurd's and Mach's headers hid more than inline bodies
behind it, and made their out-of-line copies by turning it on.

- Declarations and includes every libc file needs (the descriptor table,
  hurd/signal.h, sigsetops.h and tls.h, lowlevellock.h, the spin-lock
  functions) are now there for all of libc (_LIBC), as GCC's build has
  them.
- Inline bodies are also defined under _FORCE_INLINES, which the files
  making the out-of-line copies (hurd's generated *-inlines.c,
  mach/spin-lock.c, htl/pt-spin-inlines.c) define instead of turning on
  every public header's extern inlines.

Nothing changes for GCC. Joist, Phase 5 step 7.
---
 htl/pt-spin-inlines.c                    |  3 ++
 hurd/Makefile                            |  1 +
 hurd/hurd.h                              |  2 +-
 hurd/hurd/fd.h                           | 30 ++++++++++++++-----
 hurd/hurd/port.h                         | 24 ++++++++++-----
 hurd/hurd/userlink.h                     | 12 ++++----
 mach/lock-intern.h                       | 38 ++++++++++++++++++------
 mach/spin-lock.c                         |  4 ++-
 sysdeps/hurd/include/hurd/fd.h           |  2 --
 sysdeps/hurd/include/hurd/port.h         |  2 --
 sysdeps/hurd/include/hurd/signal.h       | 14 ++++-----
 sysdeps/mach/htl/bits/spin-lock-inline.h | 10 +++++++
 sysdeps/mach/include/lock-intern.h       | 13 ++------
 sysdeps/mach/x86/machine-lock.h          |  6 ++--
 14 files changed, 106 insertions(+), 55 deletions(-)

diff --git a/htl/pt-spin-inlines.c b/htl/pt-spin-inlines.c
index 72b14662..de22a4b7 100644
--- a/htl/pt-spin-inlines.c
+++ b/htl/pt-spin-inlines.c
@@ -24,6 +24,9 @@
 #define __PT_SPIN_INLINE	/* empty */
 
 #include <pthread.h>
+/* Directly: <pthread.h> includes it only with extern inlines, which a
+   clang build of libc doesn't have (features.h).  */
+#include <bits/spin-lock-inline.h>
 #include <shlib-compat.h>
 
 libc_hidden_def (__pthread_spin_destroy)
diff --git a/hurd/Makefile b/hurd/Makefile
index 53cb7f35..33eb61d1 100644
--- a/hurd/Makefile
+++ b/hurd/Makefile
@@ -175,6 +175,7 @@ $(inlines:%=$(objpfx)%.c): $(objpfx)%-inlines.c: %.h
 	(h="`echo $(subst /,_,$*) | tr '[a-z]' '[A-Z]'`"; \
 	 echo "#define _$${h}_H_EXTERN_INLINE /* Define real function.  */"; \
 	 echo "#define _$${h}_H_HIDDEN_DEF    /* Declare hidden definition.  */"; \
+	 echo "#define _FORCE_INLINES       /* The bodies, whatever the compiler: clang has no extern inlines in libc.  */"; \
 	 echo '#include "$<"') > $@-new
 	mv -f $@-new $@
 generated += $(inlines:=.c)
