@@ -210,7 +223,7 @@ __hurd_dfail (int fd, error_t err)
 
 extern int __hurd_sockfail (int fd, int flags, error_t err) __COLD;
 
-#ifdef __USE_EXTERN_INLINES
+#if defined __USE_EXTERN_INLINES || defined _FORCE_INLINES
 _HURD_FD_H_EXTERN_INLINE int
 __hurd_sockfail (int fd, int flags, error_t err)
