From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: aditya kale <252700881+kaleaditya28897-linux@users.noreply.github.com>
Date: Wed, 4 Nov 2026 18:37:13 +0530
Subject: [PATCH] hurd: signal.h: hidden prototypes before the inline bodies
 use them

clang refuses an asm label (libc_hidden_proto's) on a function after its
first use; with the inline bodies defined (the out-of-line copies,
_FORCE_INLINES) the prototypes came after. Nothing changes for GCC.
Joist, Phase 5 step 7.
---
 sysdeps/hurd/include/hurd/signal.h | 24 +++++++++++++-----------
 1 file changed, 13 insertions(+), 11 deletions(-)

diff --git a/sysdeps/hurd/include/hurd/signal.h b/sysdeps/hurd/include/hurd/signal.h
index 7684e05f..5342747f 100644
--- a/sysdeps/hurd/include/hurd/signal.h
+++ b/sysdeps/hurd/include/hurd/signal.h
@@ -27,6 +27,19 @@ extern error_t __sigthreadmask (struct hurd_sigstate *ss, int how,
 #define _HURD_SIGNAL_H_EXTERN_INLINE __extern_inline
 #endif
 
+/* Before the inline bodies below use them: clang refuses to rename a
+   function (the hidden alias) after its first use.  */
+libc_hidden_proto (_hurd_exception2signal)
+libc_hidden_proto (_hurd_intr_rpc_mach_msg)
+libc_hidden_proto (_hurd_thread_sigstate)
+libc_hidden_proto (_hurd_raise_signal)
+libc_hidden_proto (_hurd_sigstate_set_global_rcv)
+libc_hidden_proto (_hurd_sigstate_is_global_rcv)
+libc_hidden_proto (_hurd_sigstate_lock)
+libc_hidden_proto (_hurd_sigstate_pending)
+libc_hidden_proto (_hurd_sigstate_unlock)
+libc_hidden_proto (_hurd_sigstate_delete)
+
 #if (defined __USE_EXTERN_INLINES || defined _FORCE_INLINES) && IS_IN (libc)
 _HURD_SIGNAL_H_EXTERN_INLINE struct hurd_sigstate *
 _hurd_self_sigstate (void)
@@ -120,17 +133,6 @@ _hurd_sigstate_unlock (struct hurd_sigstate *ss)
 }
 #endif /* (defined __USE_EXTERN_INLINES || defined _FORCE_INLINES) && IS_IN (libc) */
 
-
-libc_hidden_proto (_hurd_exception2signal)
-libc_hidden_proto (_hurd_intr_rpc_mach_msg)
-libc_hidden_proto (_hurd_thread_sigstate)
-libc_hidden_proto (_hurd_raise_signal)
-libc_hidden_proto (_hurd_sigstate_set_global_rcv)
-libc_hidden_proto (_hurd_sigstate_is_global_rcv)
-libc_hidden_proto (_hurd_sigstate_lock)
-libc_hidden_proto (_hurd_sigstate_pending)
-libc_hidden_proto (_hurd_sigstate_unlock)
-libc_hidden_proto (_hurd_sigstate_delete)
 #endif
 #ifdef _HURD_SIGNAL_H_HIDDEN_DEF
 libc_hidden_def (_hurd_self_sigstate)
