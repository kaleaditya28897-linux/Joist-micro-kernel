+/* The exported functions' callbacks as a context.  Their USE_INIT_PORT is
+   given plain_operate, which does the operation the innermost
+   plain_use_init_port of this thread was given: each such call keeps the
+   one it replaces, so nested lookups (a signal handler's too) find
+   theirs.  */
+
+static __thread struct hurd_port_op *plain_op;
+
+static error_t
+plain_operate (mach_port_t port)
+{
+  return (*plain_op->fn) (plain_op, port);
+}
+
+static error_t
+plain_use_init_port (const struct hurd_lookup_ctx *ctx, int which,
+		     struct hurd_port_op *op)
+{
+  const struct hurd_lookup_plain *p = (const struct hurd_lookup_plain *) ctx;
+  struct hurd_port_op *outer = plain_op;
+  error_t err;
+
+  if (p->use_init_port == &_hurd_ports_use)
+    return _hurd_ports_use_op (which, op);
+  plain_op = op;
+  err = (*p->use_init_port) (which, &plain_operate);
+  plain_op = outer;
+  return err;
+}
+
+static file_t
+plain_get_dtable_port (const struct hurd_lookup_ctx *ctx, int fd)
+{
+  const struct hurd_lookup_plain *p = (const struct hurd_lookup_plain *) ctx;
+  return (*p->get_dtable_port) (fd);
+}
+
+void
+_hurd_lookup_plain (struct hurd_lookup_plain *p,
+		    error_t (*use_init_port)
+		      (int which, error_t (*operate) (mach_port_t)),
+		    file_t (*get_dtable_port) (int fd),
+		    error_t (*lookup)
+		      (file_t dir, const char *name, int flags, mode_t mode,
+		       retry_type *do_retry, string_t retry_name,
+		       mach_port_t *result))
+{
+  p->ctx.use_init_port = plain_use_init_port;
+  p->ctx.get_dtable_port = get_dtable_port ? plain_get_dtable_port : NULL;
+  p->ctx.lookup = lookup;
+  p->use_init_port = use_init_port;
+  p->get_dtable_port = get_dtable_port;
+}
+
