+/* The nested functions this file had, which clang lacks, as functions
+   given their context.  */
+
+/* The lookup of *FILE_NAME (its leading slashes trimmed there) from the
+   port.  */
+struct lookup_op
+{
+  struct hurd_port_op op;
+  __typeof (((struct hurd_lookup_ctx *) 0)->lookup) lookup;
+  char **file_name;
+  int flags;
+  mode_t mode;
+  enum retry_type *doretry;
+  char *retryname;
+  file_t *result;
+};
+
+static error_t
+lookup_op (struct hurd_port_op *op, file_t startdir)
+{
+  struct lookup_op *l = (struct lookup_op *) op;
+  char *file_name = *l->file_name;
+
+  if (file_name[0] == '/' && file_name[1] != '\0')
+    {
+      while (file_name[1] == '/')
+	/* Remove double leading slash.  */
+	file_name++;
+      if (file_name[1] != '\0')
+	/* Remove leading slash when we have more than the slash.  */
+	file_name++;
+    }
+  *l->file_name = file_name;
+
+  return lookup_error ((*l->lookup) (startdir, file_name, l->flags, l->mode,
+				     l->doretry, l->retryname, l->result));
+}
+
+/* Authenticate with the auth port: the new port in *RESULT.  */
+struct reauth_op
+{
+  struct hurd_port_op op;
+  mach_port_t ref;
+  file_t *result;
+};
+
+static error_t
+reauth (struct hurd_port_op *op, auth_t auth)
+{
+  struct reauth_op *r = (struct reauth_op *) op;
+  return __auth_user_authenticate (auth, r->ref, MACH_MSG_TYPE_MAKE_SEND,
+				   r->result);
+}
+
+/* UNAUTH (its reference consumed) reauthenticated, into *RESULT.  */
+static error_t
+reauthenticate (const struct hurd_lookup_ctx *ctx, file_t unauth,
+		file_t *result)
+{
+  error_t err;
+  struct reauth_op r = { { reauth }, __mach_reply_port (), result };
+  err = __io_reauthenticate (unauth, r.ref, MACH_MSG_TYPE_MAKE_SEND);
+  if (! err)
+    err = (*ctx->use_init_port) (ctx, INIT_PORT_AUTH, &r.op);
+  __mach_port_destroy (__mach_task_self (), r.ref);
+  __mach_port_deallocate (__mach_task_self (), unauth);
+  return err;
+}
