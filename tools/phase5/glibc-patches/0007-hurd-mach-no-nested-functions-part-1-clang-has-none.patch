From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: aditya kale <252700881+kaleaditya28897-linux@users.noreply.github.com>
Date: Wed, 4 Nov 2026 19:31:35 +0530
Subject: [PATCH] hurd, mach: no nested functions, part 1 (clang has none)

devstream.c, hurdid.c, hurdkill.c, kill.c, getcwd.c, xattr.c: each nested
function a static function taking what it used, or (getcwd's cleanup,
which used seven locals) a macro. Joist, Phase 5 step 7.
---
 hurd/hurdid.c              |  47 +++++-----
 hurd/hurdkill.c            |  34 +++++---
 hurd/xattr.c               |  20 +++--
 mach/devstream.c           |  60 +++++++------
 sysdeps/mach/hurd/getcwd.c |  30 ++++---
 sysdeps/mach/hurd/kill.c   | 171 ++++++++++++++++++++-----------------
 6 files changed, 199 insertions(+), 163 deletions(-)

diff --git a/hurd/hurdid.c b/hurd/hurdid.c
index 484887fc..859f28a2 100644
--- a/hurd/hurdid.c
+++ b/hurd/hurdid.c
@@ -22,6 +22,29 @@
 struct hurd_id_data _hurd_id;
 
 
+/* Free P's ids.  Not a nested function, which clang lacks: it captured
+   nothing.  */
+static inline void
+check_ids_dealloc (__typeof (_hurd_id.gen) *p)
+{
+  if (p->uids)
+    {
+      __vm_deallocate (__mach_task_self (),
+		       (vm_address_t) p->uids,
+		       p->nuids * sizeof (uid_t));
+      p->uids = NULL;
+    }
+  p->nuids = 0;
+  if (p->gids)
+    {
+      __vm_deallocate (__mach_task_self (),
+		       (vm_address_t) p->gids,
+		       p->ngids * sizeof (gid_t));
+      p->gids = NULL;
+    }
+  p->ngids = 0;
+}
+
 /* Check that _hurd_id.{gen,aux} are valid and update them if not.
    Expects _hurd_id.lock to be held and does not release it.  */
 
@@ -30,30 +53,10 @@ _hurd_check_ids (void)
 {
   if (! _hurd_id.valid)
     {
-      inline void dealloc (__typeof (_hurd_id.gen) *p)
-	{
-	  if (p->uids)
-	    {
-	      __vm_deallocate (__mach_task_self (),
-			       (vm_address_t) p->uids,
-			       p->nuids * sizeof (uid_t));
-	      p->uids = NULL;
-	    }
-	  p->nuids = 0;
-	  if (p->gids)
-	    {
-	      __vm_deallocate (__mach_task_self (),
-			       (vm_address_t) p->gids,
-			       p->ngids * sizeof (gid_t));
-	      p->gids = NULL;
-	    }
-	  p->ngids = 0;
-	}
-
       error_t err;
 
-      dealloc (&_hurd_id.gen);
-      dealloc (&_hurd_id.aux);
+      check_ids_dealloc (&_hurd_id.gen);
+      check_ids_dealloc (&_hurd_id.aux);
 
       if (_hurd_id.rid_auth != MACH_PORT_NULL)
 	{
diff --git a/hurd/hurdkill.c b/hurd/hurdkill.c
index 952ddfe1..39ce6f5b 100644
--- a/hurd/hurdkill.c
+++ b/hurd/hurdkill.c
@@ -23,6 +23,23 @@
 #include <hurd/signal.h>
 #include <hurd/msg.h>
 
+/* Send SIG to process PID through PROC (the proc server); *DELIVERED is
+   set if it was.  Not a nested function in _hurd_sig_post, which clang
+   lacks.  */
+static error_t
+sig_post_one (mach_port_t proc, pid_t pid, int sig, mach_port_t arg_refport,
+	      int *delivered)
+{
+  error_t err = HURD_MSGPORT_RPC (__proc_getmsgport (proc, pid, &msgport),
+				  (refport = arg_refport, 0), 0,
+				  /* If no message port we cannot send signals.  */
+				  msgport == MACH_PORT_NULL ? EPERM
+				  : __msg_sig_post (msgport, sig, 0, refport));
+  if (! err)
+    *delivered = 1;
+  return err;
+}
+
 /* Send a `sig_post' RPC to process number PID.  If PID is zero,
    send the message to all processes in the current process's process group.
    If PID is < -1, send SIG to all processes in process group - PID.
@@ -35,17 +52,6 @@ _hurd_sig_post (pid_t pid, int sig, mach_port_t arg_refport)
   mach_port_t proc;
   struct hurd_userlink ulink;
 
-  inline void kill_pid (pid_t pid) /* Kill one PID.  */
-    {
-      err = HURD_MSGPORT_RPC (__proc_getmsgport (proc, pid, &msgport),
-			      (refport = arg_refport, 0), 0,
-			      /* If no message port we cannot send signals.  */
-			      msgport == MACH_PORT_NULL ? EPERM
-			      : __msg_sig_post (msgport, sig, 0, refport));
-      if (! err)
-	delivered = 1;
-    }
-
   proc = _hurd_port_get (&_hurd_ports[INIT_PORT_PROC], &ulink);
 
   if (pid <= 0)
@@ -65,7 +71,7 @@ _hurd_sig_post (pid_t pid, int sig, mach_port_t arg_refport)
 	      self = 1;
 	    else
 	      {
-		kill_pid (pids[i]);
+		err = sig_post_one (proc, pids[i], sig, arg_refport, &delivered);
 		if (err == ESRCH)
 		  /* The process died already.  Ignore it.  */
 		  err = 0;
@@ -75,11 +81,11 @@ _hurd_sig_post (pid_t pid, int sig, mach_port_t arg_refport)
 			     (vm_address_t) pids, npids * sizeof (pids[0]));
 
 	  if (self)
-	    kill_pid (_hurd_pid);
+	    err = sig_post_one (proc, _hurd_pid, sig, arg_refport, &delivered);
 	}
     }
   else
-    kill_pid (pid);
+    err = sig_post_one (proc, pid, sig, arg_refport, &delivered);
 
   _hurd_port_free (&_hurd_ports[INIT_PORT_PROC], &ulink, proc);
 
diff --git a/hurd/xattr.c b/hurd/xattr.c
index db72a592..13afc106 100644
--- a/hurd/xattr.c
+++ b/hurd/xattr.c
@@ -195,18 +195,23 @@ _hurd_xattr_remove (io_t port, const char *name)
   return _hurd_xattr_set (port, name, NULL, 0, XATTR_REPLACE);
 }
 
+/* Count NAME (LEN bytes) in *TOTAL, and copy it to *BUFP if it fits in
+   SIZE.  Not a nested function in _hurd_xattr_list, which clang lacks.  */
+static inline void
+xattr_list_add (const char *name, size_t len, size_t *total, char **bufp,
+		size_t size)
+{
+  *total += len;
+  if (*bufp != NULL && *total <= size)
+    *bufp = __mempcpy (*bufp, name, len);
+}
+
 error_t
 _hurd_xattr_list (io_t port, void *buffer, size_t *size)
 {
   size_t total = 0;
   char *bufp = buffer;
-  inline void add (const char *name, size_t len)
-    {
-      total += len;
-      if (bufp != NULL && total <= *size)
-	bufp = __mempcpy (bufp, name, len);
-    }
-#define add(s) add (s, sizeof s)
+#define add(s) xattr_list_add (s, sizeof s, &total, &bufp, *size)
 
   struct stat64 st;
   error_t err = __io_stat (port, &st);
@@ -222,4 +227,5 @@ _hurd_xattr_list (io_t port, void *buffer, size_t *size)
     return ERANGE;
   *size = total;
   return 0;
+#undef add
 }
diff --git a/mach/devstream.c b/mach/devstream.c
index a9968211..5d7d751b 100644
--- a/mach/devstream.c
+++ b/mach/devstream.c
@@ -25,38 +25,42 @@
 #include <libioP.h>
 
 
-static ssize_t
-devstream_write (void *cookie, const char *buffer, size_t n)
+/* Not nested functions, which clang lacks: DEV is passed.  */
+static int
+devstream_write_some (device_t dev, const char *p, size_t to_write)
 {
-  const device_t dev = (device_t) (uintptr_t) cookie;
+  kern_return_t err;
+  int wrote;
+  int thiswrite;
 
-  int write_some (const char *p, size_t to_write)
+  while (to_write > 0)
     {
-      kern_return_t err;
-      int wrote;
-      int thiswrite;
+      thiswrite = to_write;
+      if (thiswrite > IO_INBAND_MAX)
+	thiswrite = IO_INBAND_MAX;
 
-      while (to_write > 0)
+      if (err = device_write_inband (dev, 0, 0, p, thiswrite, &wrote))
 	{
-	  thiswrite = to_write;
-	  if (thiswrite > IO_INBAND_MAX)
-	    thiswrite = IO_INBAND_MAX;
-
-	  if (err = device_write_inband (dev, 0, 0, p, thiswrite, &wrote))
-	    {
-	      errno = err;
-	      return 0;
-	    }
-	  p += wrote;
-	  to_write -= wrote;
+	  errno = err;
+	  return 0;
 	}
-      return 1;
-    }
-  int write_crlf (void)
-    {
-      static const char crlf[] = "\r\n";
-      return write_some (crlf, 2);
+      p += wrote;
+      to_write -= wrote;
     }
+  return 1;
+}
+
+static int
+devstream_write_crlf (device_t dev)
+{
+  static const char crlf[] = "\r\n";
+  return devstream_write_some (dev, crlf, 2);
+}
+
+static ssize_t
+devstream_write (void *cookie, const char *buffer, size_t n)
+{
+  const device_t dev = (device_t) (uintptr_t) cookie;
 
   /* Search for newlines (LFs) in the buffer.  */
 
@@ -66,8 +70,8 @@ devstream_write (void *cookie, const char *buffer, size_t n)
       /* Found one.  Write out through the preceding character,
 	 and then write a CR/LF pair.  */
 
-      if ((p > start && !write_some (start, p - start))
-	  || !write_crlf ())
+      if ((p > start && !devstream_write_some (dev, start, p - start))
+	  || !devstream_write_crlf (dev))
 	return (start - buffer) ?: -1;
 
       n -= p + 1 - start;
@@ -75,7 +79,7 @@ devstream_write (void *cookie, const char *buffer, size_t n)
     }
 
   /* Write the remainder of the buffer.  */
-  if (write_some (start, n))
+  if (devstream_write_some (dev, start, n))
     start += n;
   return (start - buffer) ?: -1;
 }
diff --git a/sysdeps/mach/hurd/getcwd.c b/sysdeps/mach/hurd/getcwd.c
index 9b480718..9591d015 100644
--- a/sysdeps/mach/hurd/getcwd.c
+++ b/sysdeps/mach/hurd/getcwd.c
@@ -51,19 +51,22 @@ __hurd_canonicalize_directory_name_internal (file_t thisdir,
   unsigned int dirbufsize = 0;
   const size_t orig_size = size;
 
-  inline void cleanup (void)
-    {
-      if (parent != thisdir)
-	__mach_port_deallocate (__mach_task_self (), parent);
-
-      __mach_port_deallocate (__mach_task_self (), thisid);
-      __mach_port_deallocate (__mach_task_self (), thisdevid);
-      __mach_port_deallocate (__mach_task_self (), rootid);
-
-      if (dirbuf != NULL)
-	__vm_deallocate (__mach_task_self (),
-			 (vm_address_t) dirbuf, dirbufsize);
-    }
+  /* A macro, not a nested function, which clang lacks.  */
+#define cleanup()							      \
+  do									      \
+    {									      \
+      if (parent != thisdir)						      \
+	__mach_port_deallocate (__mach_task_self (), parent);		      \
+									      \
+      __mach_port_deallocate (__mach_task_self (), thisid);		      \
+      __mach_port_deallocate (__mach_task_self (), thisdevid);		      \
+      __mach_port_deallocate (__mach_task_self (), rootid);		      \
+									      \
+      if (dirbuf != NULL)						      \
+	__vm_deallocate (__mach_task_self (),				      \
+			 (vm_address_t) dirbuf, dirbufsize);		      \
+    }									      \
+  while (0)
 
 
   if (size <= 0)
@@ -273,6 +276,7 @@ __hurd_canonicalize_directory_name_internal (file_t thisdir,
     free (file_name);
   cleanup ();
   return NULL;
+#undef cleanup
 }
 strong_alias (__hurd_canonicalize_directory_name_internal, _hurd_canonicalize_directory_name_internal)
 
diff --git a/sysdeps/mach/hurd/kill.c b/sysdeps/mach/hurd/kill.c
index 630a8724..db805fce 100644
--- a/sysdeps/mach/hurd/kill.c
+++ b/sysdeps/mach/hurd/kill.c
@@ -25,6 +25,96 @@
 #include <hurd/signal.h>
 #include <hurd/msg.h>
 
+/* Send SIG to the process whose message port is MSGPORT, or translate it
+   to a task operation if it has none (TASKERR the error fetching its task,
+   REFPORT its task or session port).  Not a nested function in __kill,
+   which clang lacks.  */
+static error_t
+kill_port (int sig, error_t taskerr, mach_port_t msgport,
+	   mach_port_t refport)
+{
+  if (msgport != MACH_PORT_NULL)
+    /* Send a signal message to his message port.  */
+    return __msg_sig_post (msgport, sig, SI_USER, refport);
+
+  /* The process has no message port.  Perhaps try direct
+     frobnication of the task.  */
+
+  if (taskerr)
+    /* If we could not get the task port, we can do nothing.  */
+    return taskerr;
+
+  if (refport == MACH_PORT_NULL)
+    /* proc_pid2task returned success with a null task port.
+       That means the process is a zombie.  Signals
+       to zombies should return success and do nothing.  */
+    return 0;
+
+  /* For user convenience in the case of a task that has
+     not registered any message port with the proc server,
+     translate a few signals to direct task operations.  */
+  switch (sig)
+    {
+      /* The only signals that really make sense for an
+	 unregistered task are kill, suspend, and continue.  */
+    case SIGSTOP:
+    case SIGTSTP:
+      return __task_suspend (refport);
+    case SIGCONT:
+      return __task_resume (refport);
+    case SIGTERM:
+    case SIGQUIT:
+    case SIGINT:
+      return __task_terminate (refport);
+    default:
+      /* We have full permission to send signals, but there is
+	 no meaningful way to express this signal.  */
+      return EPERM;
+    }
+}
+
+/* Send SIG to process PID through PROC (the proc server); *DELIVERED is
+   set if it was.  Not a nested function in __kill, which clang lacks.  */
+static error_t
+kill_pid (mach_port_t proc, pid_t pid, int sig, int *delivered)
+{
+  error_t err;
+
+  /* SIGKILL is not delivered as a normal signal.
+     Sending SIGKILL to a process means to terminate its task.  */
+  if (sig == SIGKILL)
+    /* Fetch the process's task port and terminate the task.  We
+       loop in case the process execs and changes its task port.
+       If the old task port dies after we fetch it but before we
+       send the RPC, we get MACH_SEND_INVALID_DEST; if it dies
+       after we send the RPC request but before it is serviced, we
+       get MIG_SERVER_DIED.  */
+    do
+      {
+	task_t refport;
+	err = __proc_pid2task (proc, pid, &refport);
+	/* Ignore zombies.  */
+	if (!err && refport != MACH_PORT_NULL)
+	  {
+	    err = __task_terminate (refport);
+	    __mach_port_deallocate (__mach_task_self (), refport);
+	  }
+      } while (err == MACH_SEND_INVALID_DEST
+	       || err == MIG_SERVER_DIED);
+  else
+    {
+      error_t taskerr;
+      err = HURD_MSGPORT_RPC (__proc_getmsgport (proc, pid, &msgport),
+			      (taskerr = __proc_pid2task (proc, pid,
+							  &refport))
+			      ? __proc_getsidport (proc, &refport) : 0, 1,
+			      kill_port (sig, taskerr, msgport, refport));
+    }
+  if (! err)
+    *delivered = 1;
+  return err;
+}
+
 /* Send signal SIG to process number PID.  If PID is zero,
    send SIG to all processes in the current process's process group.
    If PID is < -1, send SIG to all processes in process group - PID.  */
@@ -44,83 +134,6 @@ __kill (pid_t pid, int sig)
       /* NOTREACHED */
     }
 
