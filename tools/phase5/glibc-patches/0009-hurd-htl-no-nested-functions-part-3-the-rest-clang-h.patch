+
+static file_t
+child_fd (const struct hurd_lookup_ctx *ctx, int fd)
+{
+  struct spawn *s = (struct spawn *) ctx;
+  file_t *dtable = *s->dtable;
+  if ((unsigned int) fd < *s->dtablesize && dtable[fd] != MACH_PORT_NULL)
+    {
+      if (*s->flags & POSIX_SPAWN_RESETIDS)
+	{
+	  /* Reauthenticate this descriptor right now,
+	     since it is going to be used on behalf of the child.  */
+	  errno = sp_reauthenticate_fd (s, fd);
+	  if (errno)
+	    return MACH_PORT_NULL;
+	}
+      __mach_port_mod_refs (__mach_task_self (), dtable[fd],
+			    MACH_PORT_RIGHT_SEND, +1);
