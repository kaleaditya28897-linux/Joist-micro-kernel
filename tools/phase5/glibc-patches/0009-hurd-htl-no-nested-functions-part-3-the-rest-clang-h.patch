diff --git a/sysdeps/mach/hurd/spawni.c b/sysdeps/mach/hurd/spawni.c
index 375f7636..1f87f43e 100644
--- a/sysdeps/mach/hurd/spawni.c
+++ b/sysdeps/mach/hurd/spawni.c
@@ -34,6 +34,329 @@
 #include <argz.h>
 #include "spawn_int.h"
 
+/* __spawni's helpers: functions given their context, not the nested
+   functions they were, which clang lacks.  The context points at
+   __spawni's locals, which change as it goes.  */
+struct spawn
+{
+  struct hurd_lookup_ctx ctx;	/* child_init_port, child_fd.  */
+  const short int *flags;
+  const auth_t *auth;
+  file_t *ccwdir;		/* Child current working dir.  */
+  file_t *rcrdir, *rcwdir;
+  file_t **dtable;
+  unsigned int *dtablesize;
+  struct hurd_port ***dtable_cells;
+  struct hurd_userlink **ulink_dtable;
+};
+
+/* For POSIX_SPAWN_RESETIDS, this reauthenticates our root/current
+   directory ports with the new AUTH port.  */
+static error_t
+sp_reauthenticate (struct spawn *s, int which, file_t *result)
+{
+  error_t err;
+  mach_port_t ref;
+  auth_t auth = *s->auth;
+  if (*result != MACH_PORT_NULL)
+    return 0;
+  ref = __mach_reply_port ();
+  if (which == INIT_PORT_CWDIR && *s->ccwdir != MACH_PORT_NULL)
+    {
+      err = __io_reauthenticate (*s->ccwdir, ref, MACH_MSG_TYPE_MAKE_SEND);
+      if (!err)
+	err = __auth_user_authenticate (auth,
+					ref, MACH_MSG_TYPE_MAKE_SEND,
+					result);
+    }
+  else
+    err = HURD_PORT_USE
+      (&_hurd_ports[which],
+       ({
+	 err = __io_reauthenticate (port, ref, MACH_MSG_TYPE_MAKE_SEND);
+	 if (!err)
+	   err = __auth_user_authenticate (auth,
+					   ref, MACH_MSG_TYPE_MAKE_SEND,
+					   result);
+	 err;
+       }));
+  __mach_port_destroy (__mach_task_self (), ref);
+  return err;
+}
+
+/* Reauthenticate one of our file descriptors for the child.  A null
+   element of DTABLE_CELLS indicates a descriptor that was already
+   reauthenticated, or was newly opened on behalf of the child.  */
+static error_t
+sp_reauthenticate_fd (struct spawn *s, int fd)
+{
+  file_t *dtable = *s->dtable;
+  struct hurd_port **dtable_cells = *s->dtable_cells;
+  if (dtable_cells[fd] != NULL && dtable[fd] != MACH_PORT_NULL)
+    {
+      file_t newfile;
+      mach_port_t ref = __mach_reply_port ();
+      error_t err = __io_reauthenticate (dtable[fd],
+					 ref, MACH_MSG_TYPE_MAKE_SEND);
+      if (!err)
+	err = __auth_user_authenticate (*s->auth,
+					ref, MACH_MSG_TYPE_MAKE_SEND,
+					&newfile);
+      __mach_port_destroy (__mach_task_self (), ref);
+      if (err)
+	return err;
+      _hurd_port_free (dtable_cells[fd], &(*s->ulink_dtable)[fd], dtable[fd]);
+      dtable_cells[fd] = NULL;
+      dtable[fd] = newfile;
+    }
+  return 0;
+}
+
+/* These callbacks are for looking up file names on behalf of the child.  */
+static error_t
+child_init_port (const struct hurd_lookup_ctx *ctx, int which,
+		 struct hurd_port_op *op)
+{
+  struct spawn *s = (struct spawn *) ctx;
+  if (*s->flags & POSIX_SPAWN_RESETIDS)
+    switch (which)
+      {
+      case INIT_PORT_AUTH:
+	return (*op->fn) (op, *s->auth);
+      case INIT_PORT_CRDIR:
+	return (sp_reauthenticate (s, INIT_PORT_CRDIR, s->rcrdir)
+		?: (*op->fn) (op, *s->rcrdir));
+      case INIT_PORT_CWDIR:
+	return (sp_reauthenticate (s, INIT_PORT_CWDIR, s->rcwdir)
+		?: (*op->fn) (op, *s->rcwdir));
+      }
+  else
+    switch (which)
+      {
+      case INIT_PORT_CWDIR:
+	if (*s->ccwdir != MACH_PORT_NULL)
+	  return (*op->fn) (op, *s->ccwdir);
+	break;
+      }
+  assert (which != INIT_PORT_PROC);
+  return _hurd_ports_use_op (which, op);
