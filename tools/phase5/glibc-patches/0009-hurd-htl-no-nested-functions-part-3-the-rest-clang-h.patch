+
+/* The child's lookups, its cwd STARTDIR.  */
+struct spawn_under
+{
+  struct hurd_lookup_ctx ctx;
+  struct spawn *s;
+  file_t startdir;
+};
+
+static error_t
+under_init_port (const struct hurd_lookup_ctx *ctx, int which,
+		 struct hurd_port_op *op)
+{
+  const struct spawn_under *u = (const struct spawn_under *) ctx;
+  return (which == INIT_PORT_CWDIR ? (*op->fn) (op, u->startdir)
+	  : child_init_port (&u->s->ctx, which, op));
+}
+
+static file_t
+under_child_fd (const struct hurd_lookup_ctx *ctx, int fd)
+{
+  const struct spawn_under *u = (const struct spawn_under *) ctx;
+  return child_fd (&u->s->ctx, fd);
+}
+
+static inline error_t
+sp_child_lookup_under (struct spawn *s, file_t startdir, const char *file,
+		       int oflag, mode_t mode, file_t *result)
+{
+  struct spawn_under u =
+    { { under_init_port, under_child_fd, NULL }, s, startdir };
+  return __hurd_file_name_lookup_c (&u.ctx, file, oflag, mode, result);
+}
+
+static error_t
+sp_child_fchdir (struct spawn *s, int fd)
+{
+  file_t new_ccwdir;
+  error_t err;
+  file_t *dtable = *s->dtable;
+  struct hurd_port **dtable_cells = *s->dtable_cells;
+
+  if ((unsigned int)fd >= *s->dtablesize
+      || dtable[fd] == MACH_PORT_NULL)
+    return EBADF;
+
+  /* We look up "." to force ENOTDIR if it's not a directory and EACCES if
+     we don't have search permission.  */
+  if (dtable_cells[fd] != NULL)
+      err = HURD_PORT_USE (dtable_cells[fd],
+		({
+		  sp_child_lookup_under (s, port, ".", O_NOTRANS, 0,
+					 &new_ccwdir);
+		 }));
+  else
+      err = sp_child_lookup_under (s, dtable[fd], ".", O_NOTRANS, 0,
+				   &new_ccwdir);
+
+  if (!err)
+    {
+      if (*s->ccwdir != MACH_PORT_NULL)
+	__mach_port_deallocate (__mach_task_self (), *s->ccwdir);
+      *s->ccwdir = new_ccwdir;
+    }
+
+  return err;
+}
+
+/* Close a file descriptor in the child.  */
+static error_t
+sp_do_close (struct spawn *s, int fd)
+{
+  file_t *dtable = *s->dtable;
+  struct hurd_port **dtable_cells = *s->dtable_cells;
+  if ((unsigned int)fd < *s->dtablesize
+      && dtable[fd] != MACH_PORT_NULL)
+    {
+      if (dtable_cells[fd] == NULL)
+	__mach_port_deallocate (__mach_task_self (), dtable[fd]);
+      else
+	{
+	  _hurd_port_free (dtable_cells[fd],
+			   &(*s->ulink_dtable)[fd], dtable[fd]);
+	}
+      dtable_cells[fd] = NULL;
+      dtable[fd] = MACH_PORT_NULL;
+      return 0;
+    }
+  return EBADF;
