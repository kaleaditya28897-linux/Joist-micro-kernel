diff --git a/hurd/catch-signal.c b/hurd/catch-signal.c
index e0c4a97c..abb8df1c 100644
--- a/hurd/catch-signal.c
+++ b/hurd/catch-signal.c
@@ -21,24 +21,80 @@
 #include <string.h>
 #include <assert.h>
 
-error_t
-__hurd_catch_signal (sigset_t sigset,
-		     unsigned long int first, unsigned long int last,
-		     error_t (*operate) (struct hurd_signal_preemptor *),
-		     sighandler_t handler)
+/* A catch of a signal: its preemptor, and where `throw' goes back to.
+   Not the nested functions there were (a throw for each catch, using its
+   jump buffer), which clang lacks: the preemptor function, run when the
+   signal matches (in the signal thread, this thread stopped, SS->lock
+   held), marks its catch the one fired, and no other catch of this
+   thread; throw, run in this thread, finds that one.  */
+struct catch
+{
+  struct hurd_signal_preemptor pe;
+  int fired;
+  sigjmp_buf *sigbuf;		/* siglongjmp to this, if not NULL, */
+  jmp_buf *buf;			/* else longjmp to this.  */
+};
+
+static void throw (int signo, long int sigcode, struct sigcontext *scp);
+#define THROW ((sighandler_t) &throw)
+
+static void
+throw (int signo, long int sigcode, struct sigcontext *scp)
+{
+  struct hurd_sigstate *const ss = _hurd_self_sigstate ();
+  struct hurd_signal_preemptor *pe;
+  int error = scp->sc_error ?: EGRATUITOUS;
+
+  for (pe = ss->preemptors; pe != NULL; pe = pe->next)
+    if (pe->handler == THROW && ((struct catch *) pe)->fired)
+      break;
+  assert (pe != NULL);
+  struct catch *c = (struct catch *) pe;
+  c->fired = 0;
+  if (c->sigbuf != NULL)
+    siglongjmp (*c->sigbuf, error);
+  longjmp (*c->buf, error);
+}
+
+static sighandler_t
+catch_preempt (struct hurd_signal_preemptor *preemptor,
+	       struct hurd_sigstate *ss, int *signo,
+	       struct hurd_signal_detail *detail)
+{
+  struct hurd_signal_preemptor *pe;
+  for (pe = ss->preemptors; pe != NULL; pe = pe->next)
+    if (pe->handler == THROW)
+      ((struct catch *) pe)->fired = pe == preemptor;
+  return THROW;
+}
+
+/* A catch's preemptor: SIGSET, sigcodes [FIRST, LAST), going back to
+   SIGBUF or BUF; NEXT the next.  */
+#define CATCH(sigset, first, last, sigbuf, buf, next)			      \
+  {									      \
+    { (sigset), (first), (last), &catch_preempt, THROW, (next) },	      \
+    0, (sigbuf), (buf)							      \
+  }
+
+/* __hurd_catch_signal, OPERATE given CTX.  */
+static error_t
+catch_signal (sigset_t sigset,
+	      unsigned long int first, unsigned long int last,
+	      error_t (*operate) (struct hurd_signal_preemptor *, void *ctx),
+	      void *ctx, sighandler_t handler)
 {
   /* We need to restore the signal mask, because otherwise the
      signal-handling code will have blocked the caught signal and for
      instance calling hurd_catch_signal again would then dump core.  */
   sigjmp_buf buf;
-  void throw (int signo, long int sigcode, struct sigcontext *scp)
-    { siglongjmp (buf, scp->sc_error ?: EGRATUITOUS); }
 
-  struct hurd_signal_preemptor preemptor =
+  struct catch preemptor = CATCH (sigset, first, last, &buf, NULL, NULL);
+  if (handler != SIG_ERR)
     {
-      sigset, first, last,
-      NULL, handler == SIG_ERR ? (sighandler_t) &throw : handler,
-    };
+      /* Not our handler: no preemptor function.  */
+      preemptor.pe.preemptor = NULL;
+      preemptor.pe.handler = handler;
+    }
 
   struct hurd_sigstate *const ss = _hurd_self_sigstate ();
   error_t error;
@@ -54,12 +110,12 @@ __hurd_catch_signal (sigset_t sigset,
     {
       /* Install a signal preemptor for the thread.  */
       __spin_lock (&ss->lock);
-      preemptor.next = ss->preemptors;
-      ss->preemptors = &preemptor;
+      preemptor.pe.next = ss->preemptors;
+      ss->preemptors = &preemptor.pe;
       __spin_unlock (&ss->lock);
 
       /* Try the operation that might crash.  */
-      (*operate) (&preemptor);
+      (*operate) (&preemptor.pe, ctx);
     }
 
   /* Either FUNCTION completed happily and ERROR is still zero, or it hit
@@ -67,75 +123,103 @@ __hurd_catch_signal (sigset_t sigset,
      code in ERROR.  Now we can remove the preemptor and return.  */
 
   __spin_lock (&ss->lock);
-  assert (ss->preemptors == &preemptor);
-  ss->preemptors = preemptor.next;
+  assert (ss->preemptors == &preemptor.pe);
+  ss->preemptors = preemptor.pe.next;
   __spin_unlock (&ss->lock);
 
   return error;
 }
+
+/* __hurd_catch_signal's OPERATE, as catch_signal's.  */
+struct plain_operate
+{
+  error_t (*operate) (struct hurd_signal_preemptor *);
+};
+
+static error_t
+plain_operate (struct hurd_signal_preemptor *preemptor, void *ctx)
+{
+  return (*((struct plain_operate *) ctx)->operate) (preemptor);
+}
+
+error_t
+__hurd_catch_signal (sigset_t sigset,
+		     unsigned long int first, unsigned long int last,
+		     error_t (*operate) (struct hurd_signal_preemptor *),
+		     sighandler_t handler)
+{
+  struct plain_operate o = { operate };
+  return catch_signal (sigset, first, last, &plain_operate, &o, handler);
+}
 strong_alias (__hurd_catch_signal, hurd_catch_signal)
 
 
+/* The safe functions' operations.  */
+struct mem_op
+{
+  void *dest;
+  const void *src;
+  int byte;
+  size_t nbytes;
+};
+
+static error_t
+memset_op (struct hurd_signal_preemptor *preemptor, void *ctx)
+{
+  struct mem_op *m = ctx;
+  memset (m->dest, m->byte, m->nbytes);
+  return 0;
+}
+
+static error_t
+memcpy_op (struct hurd_signal_preemptor *preemptor, void *ctx)
+{
+  struct mem_op *m = ctx;
+  memcpy (m->dest, m->src, m->nbytes);
+  return 0;
+}
+
 error_t
 hurd_safe_memset (void *dest, int byte, size_t nbytes)
 {
-  error_t operate (struct hurd_signal_preemptor *preemptor)
-    {
-      memset (dest, byte, nbytes);
-      return 0;
-    }
-  return __hurd_catch_signal (__sigmask (SIGBUS) | __sigmask (SIGSEGV),
-			      (vm_address_t) dest, (vm_address_t) dest + nbytes,
-			      &operate, SIG_ERR);
+  struct mem_op m = { dest, NULL, byte, nbytes };
+  return catch_signal (__sigmask (SIGBUS) | __sigmask (SIGSEGV),
+		       (vm_address_t) dest, (vm_address_t) dest + nbytes,
+		       &memset_op, &m, SIG_ERR);
 }
 
 
 error_t
 hurd_safe_copyout (void *dest, const void *src, size_t nbytes)
 {
-  error_t operate (struct hurd_signal_preemptor *preemptor)
-    {
-      memcpy (dest, src, nbytes);
-      return 0;
-    }
-  return __hurd_catch_signal (__sigmask (SIGBUS) | __sigmask (SIGSEGV),
-			      (vm_address_t) dest, (vm_address_t) dest + nbytes,
-			      &operate, SIG_ERR);
+  struct mem_op m = { dest, src, 0, nbytes };
+  return catch_signal (__sigmask (SIGBUS) | __sigmask (SIGSEGV),
+		       (vm_address_t) dest, (vm_address_t) dest + nbytes,
+		       &memcpy_op, &m, SIG_ERR);
 }
 
 error_t
 hurd_safe_copyin (void *dest, const void *src, size_t nbytes)
 {
-  error_t operate (struct hurd_signal_preemptor *preemptor)
-    {
-      memcpy (dest, src, nbytes);
-      return 0;
-    }
-  return __hurd_catch_signal (__sigmask (SIGBUS) | __sigmask (SIGSEGV),
-			      (vm_address_t) src, (vm_address_t) src + nbytes,
-			      &operate, SIG_ERR);
+  struct mem_op m = { dest, src, 0, nbytes };
+  return catch_signal (__sigmask (SIGBUS) | __sigmask (SIGSEGV),
+		       (vm_address_t) src, (vm_address_t) src + nbytes,
+		       &memcpy_op, &m, SIG_ERR);
 }
 
 error_t
 hurd_safe_memmove (void *dest, const void *src, size_t nbytes)
 {
   jmp_buf buf;
-  void throw (int signo, long int sigcode, struct sigcontext *scp)
-    { longjmp (buf, scp->sc_error ?: EGRATUITOUS); }
 
-  struct hurd_signal_preemptor src_preemptor =
-    {
-      __sigmask (SIGBUS) | __sigmask (SIGSEGV),
-      (vm_address_t) src, (vm_address_t) src + nbytes,
-      NULL, (sighandler_t) &throw,
-    };
-  struct hurd_signal_preemptor dest_preemptor =
-    {
-      __sigmask (SIGBUS) | __sigmask (SIGSEGV),
-      (vm_address_t) dest, (vm_address_t) dest + nbytes,
-      NULL, (sighandler_t) &throw,
-      &src_preemptor
-    };
+  struct catch src_preemptor =
+    CATCH (__sigmask (SIGBUS) | __sigmask (SIGSEGV),
+	   (vm_address_t) src, (vm_address_t) src + nbytes,
+	   NULL, &buf, NULL);
+  struct catch dest_preemptor =
+    CATCH (__sigmask (SIGBUS) | __sigmask (SIGSEGV),
+	   (vm_address_t) dest, (vm_address_t) dest + nbytes,
+	   NULL, &buf, &src_preemptor.pe);
 
   struct hurd_sigstate *const ss = _hurd_self_sigstate ();
   error_t error;
@@ -147,8 +231,8 @@ hurd_safe_memmove (void *dest, const void *src, size_t nbytes)
     {
       /* Install a signal preemptor for the thread.  */
       __spin_lock (&ss->lock);
-      src_preemptor.next = ss->preemptors;
-      ss->preemptors = &dest_preemptor;
+      src_preemptor.pe.next = ss->preemptors;
+      ss->preemptors = &dest_preemptor.pe;
       __spin_unlock (&ss->lock);
 
       /* Do the copy; it might fault.  */
@@ -160,8 +244,8 @@ hurd_safe_memmove (void *dest, const void *src, size_t nbytes)
      code in ERROR.  Now we can remove the preemptor and return.  */
 
   __spin_lock (&ss->lock);
-  assert (ss->preemptors == &dest_preemptor);
-  ss->preemptors = src_preemptor.next;
+  assert (ss->preemptors == &dest_preemptor.pe);
+  ss->preemptors = src_preemptor.pe.next;
   __spin_unlock (&ss->lock);
 
   return error;
