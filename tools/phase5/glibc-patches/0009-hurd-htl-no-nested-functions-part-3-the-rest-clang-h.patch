+
+static error_t
+sp_child_chdir (struct spawn *s, const char *name)
+{
+  file_t new_ccwdir;
+  size_t len;
+
+  /* Append trailing "/." to directory name to force ENOTDIR if
+     it's not a directory and EACCES if we don't have search
+     permission.  */
+  len = strlen (name);
+  const char *lookup = name;
+  if (len >= 2 && name[len - 2] == '/' && name[len - 1] == '.')
+    lookup = name;
+  else if (len == 0)
+    /* Special-case empty file name according to POSIX.  */
+    return __hurd_fail (ENOENT);
+  else
+    {
+      char *n = alloca (len + 3);
+      memcpy (n, name, len);
+      n[len] = '/';
+      n[len + 1] = '.';
+      n[len + 2] = '\0';
+      lookup = n;
+    }
+
+  error_t err = sp_child_lookup (s, lookup, 0, 0, &new_ccwdir);
+  if (!err)
+    {
+      if (*s->ccwdir != MACH_PORT_NULL)
+	__mach_port_deallocate (__mach_task_self (), *s->ccwdir);
+      *s->ccwdir = new_ccwdir;
+    }
