+/* A message to a kernel port is executed by the kernel inside the sender's
+   mach_msg.  rpctrace forwards every message from a single tracing thread, so
+   forwarding a traced thread's gsync_wait parks the tracer itself in the
+   kernel, and the gsync_wake that would release it is never forwarded: the
+   whole trace deadlocks.  Forward such blocking kernel RPCs from a short-lived
+   helper thread instead, using a private copy of the message (the server loop
+   reuses its buffer).  The reply still comes back through the reply proxy and
+   is traced by the tracing thread as usual.  */
+
+static int
+blocks_in_kernel (mach_msg_id_t id)
+{
+  const struct msgid_info *info = msgid_info (id);
+  return info != NULL && info->name != NULL
+	 && strcmp (info->name, "gsync_wait") == 0;
+}
+
+static void *
+forward_blocking (void *arg)
+{
+  mach_msg_header_t *msg = arg;
+  error_t err = mach_msg (msg, MACH_SEND_MSG, msg->msgh_size, 0,
+			  MACH_PORT_NULL, MACH_MSG_TIMEOUT_NONE,
+			  MACH_PORT_NULL);
+  if (err == MACH_SEND_INVALID_DEST)
+    mach_msg_destroy (msg);
+  else if (err)
+    error (0, err, "forwarding blocking kernel RPC");
+  free (msg);
+  return NULL;
+}
+
+/* Returns true if the message was handed to a helper thread.  */
+static int
+forward_in_helper (mach_msg_header_t *inp)
+{
+  pthread_t t;
+  mach_msg_header_t *copy;
+
+  if (!blocks_in_kernel (inp->msgh_id))
+    return 0;
+  copy = malloc (inp->msgh_size);
+  if (copy == NULL)
+    return 0;
+  memcpy (copy, inp, inp->msgh_size);
+  if (pthread_create (&t, NULL, forward_blocking, copy) != 0)
+    {
+      free (copy);
+      return 0;
+    }
+  pthread_detach (t);
+  return 1;
+}
+
